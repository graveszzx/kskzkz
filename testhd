local hookDetected = false

local real_HttpGet = game.HttpGet
local real_HttpGetAsync = game.HttpGetAsync

local function isHooked()
    if game.HttpGet ~= real_HttpGet then return true end
    if game.HttpGetAsync ~= real_HttpGetAsync then return true end

    -- k lclosure (lua function = hook)
    if islclosure then
        if islclosure(game.HttpGet) then return true end
        if islclosure(game.HttpGetAsync) then return true end
    end

    -- checa k: debug.getinfo como backup
    local ok, info = pcall(debug.getinfo, game.HttpGet, "S")
    if ok and info and info.what == "Lua" then return true end

    return false
end

local function showKickScreen()
    if hookDetected then return end
    hookDetected = true
    local g = Instance.new("ScreenGui")
    g.Name = "MitHubKickGui"
    g.Parent = game.CoreGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,0,1,0)
    f.BackgroundColor3 = Color3.fromRGB(0,0,0)
    f.Parent = g
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1,0,1,0)
    t.BackgroundTransparency = 1
    t.Text = "hook detected"
    t.TextColor3 = Color3.fromRGB(255,0,0)
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.Parent = f
end

local function antiHookCheck()
    if isHooked() then
        showKickScreen()
        error("", 0)
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(antiHookCheck)
    end
end)

return antiHookCheck
